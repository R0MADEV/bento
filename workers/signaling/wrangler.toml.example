name = "bento-signaling"
main = "src/worker.ts"
compatibility_date = "2026-08-23"

# Per-developer setup (once):
#   cp wrangler.toml.example wrangler.toml
#   npx wrangler login
#   npx wrangler deploy      # auto-creates the KV namespace below, no id needed
# wrangler.toml itself is gitignored — once deployed it's tied to YOUR
# Cloudflare account, not something to share/commit. No id here on purpose:
# wrangler >= 4.45 provisions the namespace itself on first deploy (see
# https://developers.cloudflare.com/changelog/post/2025-10-24-automatic-resource-provisioning/).
[[kv_namespaces]]
binding = "PAIRING"
