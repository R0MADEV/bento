{
  "name": "bento",
  "version": "0.0.1",
  "description": "Modular and open source desktop workspace",
  "type": "module",
  "dependencies": {
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@types/qrcode": "^1.5.6",
    "dockview-core": "^4.3.0",
    "hls.js": "^1.4.0",
    "qrcode": "^1.5.4",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-search": "^0.13.0",
    "xterm-addon-serialize": "^0.11.0",
    "xterm-addon-unicode11": "^0.6.0",
    "xterm-addon-web-links": "^0.9.0",
    "xterm-addon-webgl": "^0.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/cli": "^2.11.0",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint": "^10.8.0",
    "happy-dom": "^20.11.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:coverage": "node --max-old-space-size=6144 ./node_modules/vitest/vitest.mjs run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src tests scripts",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/audit-i18n.mjs",
    "bindings:generate": "cargo test --manifest-path src-tauri/Cargo.toml export_bindings && cargo test --manifest-path daemon/bento-review/Cargo.toml --features ts export_bindings",
    "bindings:check": "npm run bindings:generate && node scripts/check-generated-bindings.mjs",
    "build:e2e:app": "node scripts/build-e2e-app.mjs",
    "test:e2e:tasks": "node scripts/e2e-tasks.mjs",
    "ci:local": "npm run lint && npm run typecheck && npm test && npm run check:size && npm run i18n:check && npm run bindings:check && npm run build:e2e:app",
    "ci:remote": "node scripts/run-remote-ci.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "check:size": "node scripts/check-file-size.mjs"
  }
}
